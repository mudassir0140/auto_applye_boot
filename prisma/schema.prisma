generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  cvUrl         String?
  portfolioUrl  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
  applications  JobApplication[]
  emails        JobEmail[]
  notifications Notification[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id              String    @id @default(cuid())
  userId          String
  title           String
  company         String
  location        String?
  description     String?
  url             String    @unique
  source          String    // "linkedin", "google", "indeed", etc.
  salary          String?
  jobType         String?   // "full-time", "contract", etc.
  seniority       String?
  skills          String?   // JSON array as string
  matchScore      Float?    // 0-100 relevance score
  foundAt         DateTime  @default(now())
  savedAt         DateTime?
  applied         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application     JobApplication?
  emails          JobEmail[]

  @@index([userId])
  @@index([company])
  @@index([source])
}

model JobApplication {
  id            String    @id @default(cuid())
  jobId         String    @unique
  userId        String
  status        String    @default("applied") // "applied", "interview", "assessment", "rejected", "offer"
  appliedAt     DateTime  @default(now())
  applicationUrl String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails        JobEmail[]

  @@index([userId])
  @@index([status])
}

model JobEmail {
  id              String    @id @default(cuid())
  userId          String
  jobId           String
  applicationId   String?
  gmailMessageId  String    @unique
  from            String
  subject         String
  body            String?
  emailType       String    // "confirmation", "interview", "assessment", "rejection", "other"
  status          String?   // custom status
  isRead          Boolean   @default(false)
  receivedAt      DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application     JobApplication?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([jobId])
  @@index([applicationId])
  @@index([emailType])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // "interview", "assessment", "rejection", "offer", "email"
  title     String
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
