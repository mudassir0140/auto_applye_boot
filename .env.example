# Database
DATABASE_URL="file:./dev.db"

# NextAuth (IMPORTANT: Must include protocol and domain, no trailing slash)
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Gmail OAuth (from Google Cloud Console)
# Callback URL in Google Cloud Console must be:
#   Local: http://localhost:3000/api/auth/callback/google
#   Production: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Job Scraping APIs
LINKEDIN_API_KEY=optional
GOOGLE_JOBS_API_KEY=optional

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
