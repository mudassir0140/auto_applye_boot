# Database Configuration
# Local: file:./dev.db (SQLite)
# Production: Database connection URL (PostgreSQL recommended)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration (REQUIRED)
# IMPORTANT: Must include protocol and domain, NO trailing slash
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (REQUIRED - Get from Google Cloud Console)
# Setup: See GOOGLE_OAUTH_SETUP.md for detailed instructions
#
# Callback URL must match exactly in Google Cloud Console:
#   Local: http://localhost:3000/api/auth/callback/google
#   Production: https://your-domain.vercel.app/api/auth/callback/google
#   or: https://your-custom-domain.com/api/auth/callback/google
#
# To get these values:
# 1. Go to https://console.cloud.google.com
# 2. Create OAuth 2.0 Web Application credentials
# 3. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Job Search APIs (OPTIONAL)
# These are not required for basic functionality
# Only add if you have API access
LINKEDIN_API_KEY=optional
GOOGLE_JOBS_API_KEY=optional
