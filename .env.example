# --- Database: MongoDB Atlas (free M0 tier) ---------------------------------
# Atlas -> Database -> Connect -> Drivers -> copy the connection string and put
# a database name before the "?" (e.g. .../boot?retryWrites=true&w=majority).
# Set this ONLY in .env.local (git-ignored) and in your Vercel project settings.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/boot?retryWrites=true&w=majority"

# --- NextAuth ---------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
# No trailing slash. Local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (Google Cloud Console -> Credentials -> Web application) ---
# Enable the Gmail API. Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Background jobs --------------------------------------------------------
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/run.
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Company discovery (optional). Official Google APIs only; without keys that source is skipped.
# Google Maps: enable "Places API (New)" in Google Cloud and create an API key.
GOOGLE_MAPS_API_KEY=
# Google Search: create a Programmable Search Engine (search the entire web) and enable the Custom Search API.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
