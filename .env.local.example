# Local Development Environment Variables
# IMPORTANT: Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git - it contains sensitive information

# Database (SQLite for local development)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth Configuration
# NEXTAUTH_SECRET: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This key is used for session encryption - must be the same for all instances
NEXTAUTH_SECRET=your-super-secret-key-change-this
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Configuration
# IMPORTANT: See GOOGLE_OAUTH_SETUP.md for detailed setup instructions
#
# Get credentials from Google Cloud Console: https://console.cloud.google.com/
#
# Setup Checklist:
# ✓ Create a new Google Cloud project
# ✓ Enable Gmail API and Google+ API
# ✓ Create OAuth 2.0 Web Application credentials
# ✓ Add Authorized JavaScript origins: http://localhost:3000
# ✓ Add Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# ✓ Add your email (fmkports@gmail.com) as a test user
# ✓ Copy Client ID and Secret below
#
# Values from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional: Job Search APIs
# These are optional for basic functionality
# LINKEDIN_API_KEY=your-api-key-if-available
# GOOGLE_JOBS_API_KEY=your-api-key-if-available
